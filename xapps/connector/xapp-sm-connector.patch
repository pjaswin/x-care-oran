+void split_data(char* buf, int rcv_size, char** part1, char** part2) {
+    *part1 = nullptr;
+    *part2 = nullptr;
+    char* comma_ptr = static_cast<char*>(memchr(buf, ',', rcv_size));
+    if (comma_ptr) {
+        size_t part1_len = comma_ptr - buf;
+        *part1 = new char[part1_len + 1];
+        memcpy(*part1, buf, part1_len);
+        (*part1)[part1_len] = '\0';
+        size_t part2_len = rcv_size - (part1_len + 1);
+        if (part2_len > 0) {
+            *part2 = new char[part2_len + 1];
+            memcpy(*part2, comma_ptr + 1, part2_len);
+            (*part2)[part2_len] = '\0';
+        } else {
+            *part2 = new char[1];
+            (*part2)[0] = '\0';
+        }
+    } else {
+        *part1 = new char[rcv_size + 1];
+        memcpy(*part1, buf, rcv_size);
+        (*part1)[rcv_size] = '\0';
+        *part2 = new char[1];
+        (*part2)[0] = '\0';
+    }
+}
