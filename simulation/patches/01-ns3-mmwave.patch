 namespace ns3
 {
+std::string
+BuildUeListString(const std::map<uint16_t, Ptr<UeManager>>& ueMap)
+{
+    std::ostringstream oss;
+    bool first = true;
+    for (const auto& ue : ueMap)
+    {
+        if (ue.second == nullptr)
+        {
+            continue;
+        }
+        uint64_t imsi = ue.second->GetImsi();
+        if (!first)
+        {
+            oss << ",";
+        }
+        oss << imsi;
+        first = false;
+    }
+    return oss.str();
+}
 
 NS_LOG_COMPONENT_DEFINE("MmWaveEnbNetDevice");
